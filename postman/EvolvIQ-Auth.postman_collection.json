 ],
 "item": [
  {
   "name": "1 · Login",
   "item": [
    {
     "name": "Login — Platform Admin (saves token)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set(\"platformToken\", pm.response.json().accessToken);"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/v1/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "auth",
        "login"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
      }
     }
    },
