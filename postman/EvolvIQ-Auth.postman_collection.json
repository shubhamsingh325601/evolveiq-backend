{
 "info": {
  "name": "EvolvIQ — API (Auth & Schools)",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Run top-to-bottom with the Collection Runner. Requires the bootstrap Platform Admin and demo schools (npm run db:seed-dev). Change {{run}} to a new value for each run so emails/IDs stay unique. Folder 5 covers the Platform Admin school APIs; JWTs are never hard-coded — they are captured from the login requests into collection variables."
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:3000"
  },
  {
   "key": "adminEmail",
   "value": "root@evolviq.dev"
  },
  {
   "key": "adminPassword",
   "value": "Change-Me-Now-2026"
  },
  {
   "key": "schoolAId",
   "value": "11111111-1111-4111-8111-111111111111"
  },
  {
   "key": "schoolBId",
   "value": "22222222-2222-4222-8222-222222222222"
  },
  {
   "key": "run",
   "value": "1"
  },
  {
   "key": "platformToken",
   "value": ""
  },
  {
   "key": "schoolAdminToken",
   "value": ""
  },
  {
   "key": "teacherToken",
   "value": ""
  },
  {
   "key": "schoolId",
   "value": ""
