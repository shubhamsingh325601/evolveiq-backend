{
  "info": {
    "name": "EvolvIQ — Auth (Login & Register)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top-to-bottom with the Collection Runner. Requires the bootstrap Platform Admin and demo schools (npm run db:seed-dev). Change {{run}} to a new value for each run so emails/IDs stay unique."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "root@evolviq.dev"
    },
    {
      "key": "adminPassword",
      "value": "Change-Me-Now-2026"
    },
    {
      "key": "schoolAId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "schoolBId",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "run",
      "value": "1"
    },
    {
      "key": "platformToken",
      "value": ""
    },
    {
      "key": "schoolAdminToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · Login",
      "item": [
        {
          "name": "Login — Platform Admin (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"platformToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login — wrong password → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
