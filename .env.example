# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL (docker compose up -d creates both databases)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evolviq
DB_POOL_MAX=10
# Integration tests only. The suite DROPS this database's schema, so its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/evolviq_test

# JWT (HS256). Two DIFFERENT secrets, each at least 32 bytes. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=evolviq-api
JWT_AUDIENCE=evolviq-apps
JWT_TTL_SECONDS=3600
# Must be greater than JWT_TTL_SECONDS. Default 604800 = 7 days; max 7776000 = 90 days.
JWT_REFRESH_TTL_SECONDS=604800

# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# OpenAPI document + Scalar reference at /docs (default: on everywhere except production)
API_DOCS_ENABLED=true

# Browser origins allowed to call the API (CORS), comma-separated. Required in production, e.g.
#   CORS_ORIGINS=https://teacher.evolviq.in,https://system-admin.evolviq.in,https://family.evolviq.in
# Leave empty locally: the Vite dev proxy means the browser never calls the API cross-origin.
CORS_ORIGINS=

# Outgoing email: password-reset codes. Production uses Titan (the evolviq.in mailboxes):
#   SMTP_HOST=smtp.titan.email  SMTP_PORT=465  SMTP_USER=no-reply@evolviq.in  SMTP_PASSWORD=<its password>
# Leave SMTP_HOST empty locally: mail is then written to the log (with the code, in development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EvolvIQ <no-reply@evolviq.in>

# Used only by `npm run bootstrap:admin` to create the first Platform Admin.
# These match the Postman collection; use a real password outside local development.
BOOTSTRAP_ADMIN_EMAIL=root@evolviq.dev
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Now-2026
BOOTSTRAP_ADMIN_NAME=Root Admin
