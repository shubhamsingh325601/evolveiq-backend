// EvolvIQ — Prisma schema. Source of truth for the Prisma Client types.
// The SQL in prisma/migrations is what Prisma Migrate applies; this file mirrors it.
//
// Some database rules cannot be expressed in Prisma's schema language and live only in
// the migrations (Prisma ignores them when diffing, so they are never dropped):
//   - CHECK constraints on users (credential-by-role, school-scope-by-role, normalised
//     email / student ID), on schools.name and classes.name length, and on parent_students
//     (a user cannot be their own parent).
//   - The citext extension used by classes.name (case-insensitive uniqueness per school).
//   - CHECK constraints on observations (author is a parent or teacher, teacher-only fields,
//     consistent review state, Significant needs a development area, positive ⇔ celebrated,
//     no Level on a positive one), on assignments (recommended ⇔ linked to an observation)
//     and on text lengths.
//   - The trigger that makes monthly_summaries rows immutable.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// The six roles from the PRD / ARCHITECTURE.md. Stored as a Postgres enum.
enum UserRole {
  student
  parent
  teacher
  school_admin
  psychologist
  platform_admin

  @@map("user_role")
}

model School {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 1–200 characters (CHECK constraint in the migration).
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  classes      Class[]
  observations Observation[]

  @@index([name], map: "schools_name_idx")
  @@index([createdAt], map: "schools_created_at_idx")
  @@map("schools")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                UserRole
  /// NULL for platform-level roles (psychologist, platform_admin).
  schoolId            String?   @map("school_id") @db.Uuid
  fullName            String    @map("full_name")
  /// Adults sign in with email + password …
  email               String?
  /// … students with student ID + PIN.
  studentLoginId      String?   @map("student_login_id")
  /// argon2id hash of the password or PIN. Never plain text.
  secretHash          String    @map("secret_hash")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school        School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refreshTokens RefreshToken[]
  /// Parents: their children ("one parent, many children").
  childLinks    ParentStudent[]  @relation("ParentLinks")
  /// Students: their parent, if linked.
  parentLink    ParentStudent?   @relation("StudentLink")
  /// Teachers: the classes they teach.
  teacherOf     ClassTeacher[]
  /// Students: the one class they belong to.
  classLink     ClassStudent?

  observationsAbout    Observation[] @relation("ObservationStudent")
  observationsWritten  Observation[] @relation("ObservationAuthor")
  observationsReviewed Observation[] @relation("ObservationReviewer")
  activitiesCreated    Activity[]
  assignments          Assignment[]  @relation("AssignmentStudent")
  assignmentsGiven     Assignment[]  @relation("AssignmentAssigner")
  monthlySummaries     MonthlySummary[]
  consentsAbout        Consent[]           @relation("ConsentStudent")
  consentsDecided      Consent[]           @relation("ConsentDecider")
  wellnessCheckins     WellnessCheckin[]   @relation("WellnessStudent")
  wellnessRecorded     WellnessCheckin[]   @relation("WellnessRecorder")
  supportPlans         SupportPlan[]       @relation("SupportStudent")
  supportPlansWritten  SupportPlan[]       @relation("SupportAuthor")
  notificationState    NotificationState?

  // Partial unique indexes: race-safe duplicate prevention + the login lookup path.
  @@unique([email], map: "users_email_key", where: raw("(email IS NOT NULL)"))
  @@unique([studentLoginId], map: "users_student_login_id_key", where: raw("(student_login_id IS NOT NULL)"))
  @@map("users")
}

/// Only the JTI is stored — never the raw refresh token.
model RefreshToken {
  jti       String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// All tokens descended from one login share a family (reuse detection).
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([familyId], map: "refresh_tokens_family_active_idx", where: raw("(revoked_at IS NULL)"))
  @@map("refresh_tokens")
}

/// Parent ↔ student. The primary key on student_id = a student has at most one parent.
model ParentStudent {
  studentId String   @id @map("student_id") @db.Uuid
  parentId  String   @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student User @relation("StudentLink", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parent  User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([parentId], map: "parent_students_parent_id_idx")
  @@map("parent_students")
}

model Class {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  /// citext: unique per school ignoring case. 1–100 characters (CHECK in the migration).
  name      String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  teachers ClassTeacher[]
  students ClassStudent[]

  @@unique([schoolId, name], map: "classes_school_id_name_key")
  @@map("classes")
}

/// A class has many teachers; a teacher teaches many classes.
model ClassTeacher {
  classId   String   @map("class_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  class   Class @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([classId, teacherId])
  @@index([teacherId], map: "class_teachers_teacher_id_idx")
  @@map("class_teachers")
}

/// A student belongs to exactly one class: the primary key is student_id.
model ClassStudent {
  studentId String   @id @map("student_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student User  @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  class   Class @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([classId], map: "class_students_class_id_idx")
  @@map("class_students")
}

// ───────────────────────────── Observe → Review → Assign → Do ─────────────────────────────
// Value lists confirmed by the lead (Oct 2026). UI labels: src/modules/observations/observation-options.ts.

enum ObservationArea {
  emotions
  behaviour
  social
  learning
  communication
  physical
  routines
  other

  @@map("observation_area")
}

enum ObservationWhen {
  today
  this_week
  this_month
  over_a_month

  @@map("observation_when")
}

enum ObservationFrequency {
  once
  sometimes
  often
  daily

  @@map("observation_frequency")
}

/// Teachers only.
enum ObservationLevel {
  minor
  moderate
  significant

  @@map("observation_level")
}

/// Teachers only.
enum LearningBehaviourArea {
  attention
  participation
  following_instructions
  task_completion
  organisation
  working_with_others
  self_control
  other

  @@map("learning_behaviour_area")
}

/// Psychologist review tag. Deliberately no "other".
enum DevelopmentArea {
  managing_feelings
  social_skills
  communication
  focus_attention
  self_control
  confidence
  resilience
  independence
  learning_skills
  motor_skills

  @@map("development_area")
}

/// Concerns go pending → reviewed. A positive observation is celebrated from the start.
enum ObservationStatus {
  pending
  reviewed
  celebrated

  @@map("observation_status")
}

/// Something good (a star for the student) or something to look into (the review queue).
enum ObservationTone {
  positive
  concern

  @@map("observation_tone")
}

/// "Assign & mark reviewed" / "No action needed".
enum ReviewOutcome {
  assigned
  no_action

  @@map("review_outcome")
}

model Observation {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The student's school (users.school_id never changes).
  schoolId              String                 @map("school_id") @db.Uuid
  studentId             String                 @map("student_id") @db.Uuid
  authorId              String                 @map("author_id") @db.Uuid
  /// parent | teacher (CHECK in the migration).
  authorRole            UserRole               @map("author_role")
  /// positive ⇔ status celebrated (CHECK in the migration).
  tone                  ObservationTone        @default(concern)
  area                  ObservationArea
  description           String
  observedWhen          ObservationWhen        @map("observed_when")
  frequency             ObservationFrequency
  level                 ObservationLevel?
  learningBehaviourArea LearningBehaviourArea? @map("learning_behaviour_area")
  status                ObservationStatus      @default(pending)
  reviewOutcome         ReviewOutcome?         @map("review_outcome")
  developmentArea       DevelopmentArea?       @map("development_area")
  /// Never shown to parents.
  teacherOnlyNote       String?                @map("teacher_only_note")
  reviewedById          String?                @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  student     User         @relation("ObservationStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  author      User         @relation("ObservationAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy  User?        @relation("ObservationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignments Assignment[]

  @@index([status, createdAt], map: "observations_status_created_at_idx")
  @@index([schoolId, createdAt], map: "observations_school_id_created_at_idx")
  @@index([studentId, createdAt], map: "observations_student_id_created_at_idx")
  @@index([authorId, createdAt], map: "observations_author_id_created_at_idx")
  @@index([studentId, reviewedAt], map: "observations_student_id_reviewed_at_idx", where: raw("((review_outcome = 'assigned'::review_outcome) AND (development_area IS NOT NULL))"))
  @@index([studentId, createdAt], map: "observations_student_id_created_at_positive_idx", where: raw("(tone = 'positive'::observation_tone)"))
  @@map("observations")
}

enum ActivityType {
  mcq
  text
  image_pick
  rating
  media_response

  @@map("activity_type")
}

/// The one global activity library. Archived, never deleted.
model Activity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  type        ActivityType
  /// prompt / options / mediaUrl for the type (validated by the API).
  content     Json
  createdById String       @map("created_by_id") @db.Uuid
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignments Assignment[]

  @@index([title], map: "activities_title_idx")
  @@index([createdAt], map: "activities_created_at_idx")
  @@map("activities")
}

enum AssignmentSource {
  direct
  recommended

  @@map("assignment_source")
}

model Assignment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId    String           @map("activity_id") @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  assignedById  String           @map("assigned_by_id") @db.Uuid
  /// direct = teacher; recommended = psychologist, through an observation review.
  source        AssignmentSource
  observationId String?          @map("observation_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  activity    Activity            @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  student     User                @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedBy  User                @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  observation Observation?        @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completion  ActivityCompletion?

  @@unique([observationId, activityId], map: "assignments_observation_id_activity_id_key")
  @@index([studentId, createdAt], map: "assignments_student_id_created_at_idx")
  @@index([activityId], map: "assignments_activity_id_idx")
  @@map("assignments")
}

/// One per assignment (no reattempts).
model ActivityCompletion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String   @unique(map: "activity_completions_assignment_id_key") @map("assignment_id") @db.Uuid
  response     Json
  /// UTC; business days are Asia/Kolkata days.
  completedAt  DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([completedAt], map: "activity_completions_completed_at_idx")
  @@map("activity_completions")
}

/// One per student per COMPLETED month (Asia/Kolkata calendar); immutable (a trigger refuses
/// UPDATE / DELETE). The current month is built live and never stored.
model MonthlySummary {
  studentId String   @map("student_id") @db.Uuid
  /// First day of the month.
  month     DateTime @db.Date
  summary   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([studentId, month])
  @@map("monthly_summaries")
}

enum ConsentPurpose {
  /// The family allows daily wellbeing check-ins to be recorded.
  wellness_tracking
  /// The family allows the school's teachers and counsellor to see those check-ins.
  wellness_sharing

  @@map("consent_purpose")
}

/// A family's decision about one purpose. No row = not decided yet = not allowed.
model Consent {
  studentId   String         @map("student_id") @db.Uuid
  purpose     ConsentPurpose
  granted     Boolean
  /// The parent who made the decision.
  decidedById String         @map("decided_by_id") @db.Uuid
  decidedAt   DateTime       @default(now()) @map("decided_at") @db.Timestamptz(6)

  student   User @relation("ConsentStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedBy User @relation("ConsentDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([studentId, purpose])
  @@map("consents")
}

/// One self-reported day of wellbeing per student (mood and energy 1-5, optional sleep and
/// active minutes). Non-clinical: it is the family's own note, not a measurement or a diagnosis.
model WellnessCheckin {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  recordedById  String   @map("recorded_by_id") @db.Uuid
  /// The Asia/Kolkata calendar day the check-in is about.
  day           DateTime @db.Date
  mood          Int      @db.SmallInt
  energy        Int      @db.SmallInt
  sleepMinutes  Int?     @map("sleep_minutes") @db.SmallInt
  activeMinutes Int?     @map("active_minutes") @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    User @relation("WellnessStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedBy User @relation("WellnessRecorder", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([studentId, day], map: "wellness_checkins_student_id_day_key")
  @@map("wellness_checkins")
}

enum SupportCategory {
  learning
  attention
  speech_language
  sensory
  physical_access
  emotional
  gifted
  other

  @@map("support_category")
}

enum SupportStatus {
  active
  in_review
  closed

  @@map("support_status")
}

/// A school-side support plan for a student who needs adjustments. Staff only: never shown to
/// parents or students, and it never feeds the Holistic Index.
model SupportPlan {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String          @map("student_id") @db.Uuid
  createdById String          @map("created_by_id") @db.Uuid
  category    SupportCategory
  summary     String
  strategies  String?
  status      SupportStatus   @default(active)
  /// When the plan should next be looked at again.
  reviewOn    DateTime?       @map("review_on") @db.Date
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   User @relation("SupportStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User @relation("SupportAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([studentId, createdAt], map: "support_plans_student_id_created_at_idx")
  @@map("support_plans")
}

/// When a user last opened their notifications. The feed itself is derived, not stored.
model NotificationState {
  userId String   @id @map("user_id") @db.Uuid
  seenAt DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_states")
}
