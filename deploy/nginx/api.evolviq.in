# EvolvIQ API: reverse proxy to the backend on 127.0.0.1:3000.
# Install as /etc/nginx/sites-available/api.evolviq.in (+ symlink in sites-enabled).
# Certbot (--nginx) adds the HTTPS listener and the HTTP -> HTTPS redirect.

# Per-IP login throttle (README §8: per-account lockout doesn't stop password spraying).
# Generous on purpose: a whole class can sign in at once from one school IP.
limit_req_zone $binary_remote_addr zone=evolviq_login:10m rate=2r/s;

server {
    listen 80;
    listen [::]:80;
    server_name api.evolviq.in;

    # Spreadsheet import accepts up to 1 MB; everything else is capped at 16 KB by the app.
    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location = /api/v1/auth/login {
        limit_req zone=evolviq_login burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
